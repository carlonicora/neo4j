# Neo4j Authentication (format: username/password)
NEO4J_AUTH=neo4j/your_secure_password_here

# Note: Coolify automatically provides SERVICE_FQDN_NEO4J for Traefik routing

# Neo4j memory tuning (single source of truth; docker-compose.yml references these).
# In Coolify, leave the UI resource limits at 0 (unlimited) and drive everything here.
# Defaults (used if a variable is unset) match the values below.
# Container limits:
NEO4J_MEM_LIMIT=5g
NEO4J_MEMSWAP_LIMIT=6g
# JVM heap / page cache. Keep heap_max + pagecache + off_heap comfortably below
# NEO4J_MEM_LIMIT to leave headroom for native memory, threads, and OS.
NEO4J_server_memory_heap_initial__size=1g
NEO4J_server_memory_heap_max__size=2500m
NEO4J_server_memory_pagecache_size=1500m
NEO4J_server_memory_off__heap_max__size=256m

# Backup - Host paths (Coolify deployment path)
# These must be the ABSOLUTE HOST paths (not container paths).
# Find your Coolify app ID in the Coolify dashboard under the service settings.
# Leave empty to disable automated backups.
HOST_DATA_DIR=/data/coolify/applications/<your-coolify-app-id>/neo4j/data
HOST_BACKUP_DIR=/data/coolify/applications/<your-coolify-app-id>/data-backup

# Backup - Retention policy: which dated backups to keep, locally and on S3.
# Rules are calendar windows counted back from today, today included:
#   last=N    the N newest backups
#   daily=N   every backup from the last N calendar days
#   weekly=N / monthly=N / yearly=N   the newest backup in each of the last N weeks
#             (Monday-Sunday) / months / years, the current one included
# A backup kept by any rule survives. Only complete dates count (a dump of every database);
# incomplete dates are always deleted. Retention runs only after a fully successful backup.
# Examples: daily=14 | daily=7,weekly=4 | daily=7,weekly=4,monthly=12,yearly=2
# Default when unset: daily=7,weekly=4,monthly=12
BACKUP_RETENTION=daily=7,weekly=4,monthly=12

# Backup - Max seconds for one database's backup call (default 21600 = 6 hours)
# BACKUP_DB_TIMEOUT=21600

# Backup - S3-compatible storage (leave empty to skip S3 upload)
# Works with AWS S3, Backblaze B2, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Backup - aws-cli compatibility with S3-compatible providers (Hetzner, MinIO, R2, ...).
# aws-cli >= 2.23 adds CRC checksums to every upload by default, which many S3-compatible
# stores reject or mishandle. "when_required" restores the old behaviour. Defaults shown.
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
# Backup - aws-cli retries for dropped connections and 5xx answers. Defaults shown.
# AWS_RETRY_MODE=standard
# AWS_MAX_ATTEMPTS=10

# Backup - Upload debug log. "1" or "true" runs each upload with aws --debug and writes its
# output to data-backup/logs/<date>/<database>-upload.log. Kept only when that upload fails
# (an excerpt goes into the backup log), deleted on success, pruned after 14 days.
# The file holds request headers: it is created 0600.
# BACKUP_AWS_DEBUG=1
